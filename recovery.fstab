# Recovery fstab for Qin 2 Pro (system-as-root: system mounts at /)
#<src>                                                    <mnt_point>  <type>  <mnt_flags and options>                                <fs_mgr_flags>
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/system     /          ext4    ro,barrier=1                                             wait
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/vendor     /vendor    ext4    ro,barrier=1                                             wait
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/boot       /boot      emmc    defaults                                                 recoveryonly
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/recovery   /recovery  emmc    defaults                                                 recoveryonly
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/dtb        /dtb       emmc    defaults                                                 recoveryonly
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/dtbo       /dtbo      emmc    defaults                                                 recoveryonly
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/misc       /misc      emmc    defaults                                                 recoveryonly
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/userdata   /data      f2fs    noatime,nosuid,nodev,discard,inline_xattr,inline_data    wait,check
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/userdata   /data      ext4    noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc    wait,check
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/cache      /cache     ext4    noatime,nosuid,nodev                                     wait,check
/devices/platform/soc/soc:ap-ahb/20300000.sdio/mmc_host/mmc1/mmc1:*/block/mmcblk1  auto  vfat  defaults  voldmanaged=sdcard1:auto
/devices/platform/soc/soc:ap-ahb/20200000.usb/musb-hdrc.*.auto/usb*                auto  vfat  defaults  voldmanaged=usbdisk:auto
