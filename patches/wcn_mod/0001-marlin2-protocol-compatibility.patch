+#ifdef SIPC_SUPPORT
+/* Marlin2 consumes inline Ethernet frames in SIPC channel 8, not
+ * Marlin3 MSDU descriptors/physical-address lists. The Qin kernel's
+ * swcnblk pool uses a 32-byte transport reserve. Independently, stock
+ * sprdwl_send_data reserves 32 bytes after the data header/alignment
+ * for firmware to construct the 802.11 header; plen includes that space.
+ * On failure the caller retains both skb and msg; on success this
+ * synchronous copy has no outstanding DMA/firmware ownership of them.
+ */
+static int sprdwl_marlin2_send_data(struct sprdwl_vif *vif,
+				  struct sprdwl_msg_buf *msg,
+				  struct sk_buff *skb)
+{
+	struct swcnblk_blk blk;
+	struct sprdwl_data_hdr *hdr;
+	u16 len = sizeof(*hdr) + 2 + 32 + skb->len;
+	u8 channel = vif->mode <= SPRDWL_MODE_AP ? 8 : 9;
+	int ret;
+
+	if (skb_is_nonlinear(skb) && skb_linearize(skb))
+		return -ENOMEM;
+	if (skb->ip_summed == CHECKSUM_PARTIAL && skb_checksum_help(skb))
+		return -EINVAL;
+	ret = swcnblk_get(3, channel, &blk, 0);
+	if (ret)
+		return ret;
+	if (len + 32 > blk.length) {
+		swcnblk_put(3, channel, &blk);
+		return -EMSGSIZE;
+	}
+	memset(blk.addr, 0, 32);
+	hdr = (struct sprdwl_data_hdr *)((u8 *)blk.addr + 32);
+	memset(hdr, 0, sizeof(*hdr) + 2 + 32);
+	hdr->common.type = SPRDWL_TYPE_DATA;
+	hdr->common.ctx_id = vif->mode;
+	hdr->info1 = 2;
+	hdr->plen = cpu_to_le16(len);
+	memcpy((u8 *)hdr + sizeof(*hdr) + 2 + 32, skb->data, skb->len);
+	blk.length = len + 32;
+	ret = swcnblk_send(3, channel, &blk);
+	if (ret) {
+		swcnblk_put(3, channel, &blk);
+		return ret;
+	}
+	dev_kfree_skb_any(skb);
+	sprdwl_intf_free_msg_buf(vif->priv, msg);
+	return 0;
+}
+#endif
+
 /* if err, the caller judge the skb if need free,
