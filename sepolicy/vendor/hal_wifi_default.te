# sprd wifi: nl80211 driver + wcn cp; blobs under /system/vendor (vendor_file)
allow hal_wifi_default sprd_device:chr_file rw_file_perms;
allow hal_wifi_default sprd_sysfs:dir { getattr open read search };
allow hal_wifi_default sprd_sysfs:file { getattr open read write append };
allow hal_wifi_default sprd_data_file: dir { getattr open read write search add_name remove_name reparent rmdir lock watch watch_reads setattr create };
allow hal_wifi_default sprd_data_file: file { getattr open read write append lock map create unlink rename setattr watch watch_reads };
allow hal_wifi_default sprd_prop:property_service set;
allow hal_wifi_default vendor_file:file { getattr map open read };
allow hal_wifi_default self: netlink_socket { create getattr setattr read write append lock bind connect listen accept getopt setopt shutdown map };
allow hal_wifi_default self: netlink_route_socket { create getattr setattr read write append lock bind connect listen accept getopt setopt shutdown map };

# DriverTool uses finit_module/delete_module for sprdwl_ng. Keep module
# loading scoped to vendor_kernel_modules (only this module is relabeled).
allow hal_wifi_default self:global_capability_class_set sys_module;
allow hal_wifi_default vendor_kernel_modules:file r_file_perms;
allow hal_wifi_default vendor_kernel_modules:system module_load;

allow hal_wifi_default qin_wifi_fwpath_file:file rw_file_perms;
