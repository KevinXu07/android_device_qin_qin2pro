# Device init for Qin 2 Pro (s9863a1h10)
on early-init
    rm /vendor
    mkdir /vendor 0755 root root
    mount none /system/vendor /vendor bind rec
    rm /product
    mkdir /product 0755 root root
    mount none /system/product /product bind rec

on init
    setprop sys.usb.controller musb-hdrc.0.auto
    setprop sys.usb.configfs 1
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0xD001
    write /config/usb_gadget/g1/bcdDevice 0x0404
    write /config/usb_gadget/g1/bDeviceClass 0
    write /config/usb_gadget/g1/bDeviceSubClass 0
    write /config/usb_gadget/g1/bDeviceProtocol 0
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer "DuoQin"
    write /config/usb_gadget/g1/strings/0x409/product "Qin 2 Pro"
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "Conf 1"
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    write /config/usb_gadget/g1/configs/b.1/bmAttributes 0xc0
    mkdir /config/usb_gadget/g1/functions/ffs.adb 0770 shell shell
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    setprop sys.usb.mode normal

on fs
    mount_all --early

on late-fs
    mount_all --late

on post-fs-data
    # /data/vendor/wifi tree for wpa_supplicant control sockets
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    # sprd libwifi-hal blob writes its firmware-path param to this file;
    # sprdwl firmware is already loaded by the WCN coprocessor, so the file
    # only needs to exist and accept the write.
    write /data/vendor/wifi/fwpath "STA"
    chmod 0666 /data/vendor/wifi/fwpath
    # sprd audio HAL (audio.primary.sp9863a) creates vb_*_fake_pipe FIFOs here;
    # adev_open aborts with "create audio fifo error" if the dir is missing.
    mkdir /data/vendor/local 0771 media media
    mkdir /data/vendor/local/media 0771 media media


on property:sys.usb.config=none && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    stop adbd
    setprop sys.usb.ffs.ready 0
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    rm /config/usb_gadget/g1/configs/b.1/f3
    setprop sys.usb.state ${sys.usb.config}

on property:init.svc.adbd=stopped
    setprop sys.usb.ffs.ready 0

on property:sys.usb.config=adb && property:sys.usb.configfs=1
    start adbd

on property:sys.boot_completed=1
    exec - root root -- /system/bin/touch /dev/qin_boot_ok

on boot
    # Start diagnostic ADB even while framework services restart.
    setprop sys.usb.config adb
    start adbd
    exec - root root -- /system/bin/sh -c "echo reached > /data/boot_reached.txt; sync; dmesg > /data/kmsg_boot.txt; getprop > /data/props.txt; cat /proc/mounts > /data/mounts.txt; cat /config/usb_gadget/g1/UDC > /data/udc.txt 2>&1; getprop sys.usb.state >> /data/udc.txt; getprop ro.serialno >> /data/udc.txt; sync; sleep 30; getprop init.svc.adbd > /data/late.txt; getprop sys.usb.ffs.ready >> /data/late.txt; getprop sys.usb.state >> /data/late.txt; cat /config/usb_gadget/g1/UDC >> /data/late.txt 2>&1; ps -A | grep -i adb >> /data/late.txt; ls -la /dev/usb-ffs /dev/usb-ffs/adb >> /data/late.txt 2>&1; ls -la /config/usb_gadget/g1/functions >> /data/late.txt; ls -la /config/usb_gadget/g1/configs/b.1 >> /data/late.txt; dmesg | tail -200 > /data/kmsg_late.txt; sync"
